{
  "name": "human-fossil",
  "private": true,
  "scripts": {
    "build:css": "node scripts/fontawesome.mjs && tailwindcss -i static_src/css/input.css -o static/css/app.css --minify",
    "watch:css": "node scripts/fontawesome.mjs && tailwindcss -i static_src/css/input.css -o static/css/app.css --watch",
    "build": "npm run build:css",
    "dev": "concurrently -n css,django -c yellow,green \"npm:watch:css\" \"./manage.py runserver\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.12",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "prettier-plugin-django-templates": "^0.3.1",
    "tailwindcss": "^4.1.12"
  },
  "dependencies": {
    "@awesome.me/kit-ab3c4f3ba9": "^1.0.3"
  }
}
